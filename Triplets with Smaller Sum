class Solution {
    int countTriplets(int sum, int arr[]) {
        // code here
        Arrays.sort(arr);
        int finalans=0;
        for(int i=0; i<arr.length-2; i++){
            int j=i+1;
            int k= arr.length-1;
            
            while(j<k){
                
                int currentsum= arr[i]+arr[j]+arr[k];
               
                if(currentsum<sum){
                    int ans;
                 ans=k-j;
                 finalans+=ans;
                 j++;
                }
                else{
                   k--; 
                }
            }
        }
        return finalans;
    }
}
