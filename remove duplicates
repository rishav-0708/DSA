class Solution {
    public int removeDuplicates(int[] arr) {
        int i=0;
        int j=1;
        while(j<arr.length){
            if(arr[i]==arr[j]) j++;
            else if(arr[i]!=arr[j]){
                arr[i+1]=arr[j];
                i++;
                j++;
            }
        }
        return i+1;

